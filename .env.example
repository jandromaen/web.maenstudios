# Copia este archivo como .env.local para desarrollo y añade las mismas
# variables en Vercel → Settings → Environment Variables para producción.

# ─── Formulario de contacto (Resend) ───────────────────────────────
# 1. Crea cuenta en https://resend.com
# 2. Verifica el dominio maenstudios.com (Domains → Add Domain, DNS en tu proveedor)
# 3. Crea una API key y pégala aquí
RESEND_API_KEY=

# Remitente: debe pertenecer al dominio verificado en Resend
CONTACT_FROM_EMAIL=web@maenstudios.com

# Destinatario de los mensajes del formulario
CONTACT_TO_EMAIL=jandro@maenstudios.com

# ─── Analítica y Search Console ────────────────────────────────────
# Google Search Console → Añadir propiedad → Etiqueta HTML.
# Pega SOLO el valor del atributo content, no la etiqueta entera.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 → Admin → Flujos de datos → ID de medición (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
